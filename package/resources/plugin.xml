<?xml version="1.0" encoding="UTF-8"?>
<!-- OIE Sentinel — channel monitoring & alerting plugin. -->
<!-- Published under the terms of the Mozilla Public License 2.0. -->

<pluginMetaData path="sentinel">
    <name>OIE Sentinel</name>
    <author>Chris Gibson</author>
    <pluginVersion>${project.version}</pluginVersion>
    <mirthVersion>${plugin.supported.mc.versions}</mirthVersion>
    <url>https://openintegrationengine.org</url>
    <description>Zabbix-inspired monitoring and alerting for channel activity: inactivity, low-volume, anomaly-detection and connection-status monitors, with email, channel and SNS alert delivery.</description>

    <serverClasses>
        <string>org.openintegrationengine.plugins.sentinel.server.SentinelServicePlugin</string>
    </serverClasses>

    <migratorClass>org.openintegrationengine.plugins.sentinel.server.db.SentinelMigrator</migratorClass>

    <!-- Per-vendor MyBatis mappers (namespace "Sentinel"). Pagination on /problems and the
         activity tables needs vendor-specific LIMIT/OFFSET syntax (see sqlmap file comments),
         so — unlike a single-file plugin — each real vendor gets its own file. "all" falls back
         to the derby mapper, matching oie-totp-mfa's convention (derby is the engine's embedded
         dev-mode database). The engine merges the mapper matching the running database into its
         shared MyBatis config; paths are relative to this plugin's installed directory. -->
    <sqlMapConfigs>
        <entry>
            <string>derby</string>
            <string>mapper/derby-sqlmap.xml</string>
        </entry>
        <entry>
            <string>mysql</string>
            <string>mapper/mysql-sqlmap.xml</string>
        </entry>
        <entry>
            <string>postgres</string>
            <string>mapper/postgres-sqlmap.xml</string>
        </entry>
        <entry>
            <string>sqlserver</string>
            <string>mapper/sqlserver-sqlmap.xml</string>
        </entry>
        <entry>
            <string>oracle</string>
            <string>mapper/oracle-sqlmap.xml</string>
        </entry>
        <entry>
            <string>all</string>
            <string>mapper/derby-sqlmap.xml</string>
        </entry>
    </sqlMapConfigs>

    <library type="SERVER" path="sentinel-server-${project.version}.jar" />
    <library type="SHARED" path="sentinel-shared-${project.version}.jar" />

    <!-- AWS SDK: `sns` ONLY. The engine ships the entire AWS SDK 2.15.28 core on the server
         classpath at server-lib/aws/ (annotations, apache-client, auth, aws-core, the protocol
         jars, http-client-spi, metrics-spi, profiles, protocol-core, regions, sdk-core, sts,
         utils — plus netty 4.1.119 under aws/ext/netty and jackson 2.14.3 under
         server-lib/jackson). `sns` is the one artifact it does not ship, so it is the one
         artifact Sentinel bundles; see the AWS block in server/pom.xml for the full rationale.

         Every path listed here must exist in the built zip — the engine logs
         "could not locate library" at ERROR for each miss and silently carries on with a
         short classpath. build.sh diffs this list against the staged jars and fails the
         build on drift, so regenerate with:
           ls package/target/to-be-packed/*.jar | xargs -n1 basename -->
    <library type="SERVER" path="sns-2.15.28.jar" />

    <apiProvider type="SERVLET_INTERFACE" name="org.openintegrationengine.plugins.sentinel.shared.SentinelServletInterface" />
    <apiProvider type="SERVER_CLASS" name="org.openintegrationengine.plugins.sentinel.server.servlet.SentinelServlet" />
</pluginMetaData>
